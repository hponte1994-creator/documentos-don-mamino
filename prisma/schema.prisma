generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USUARIOS Y TIENDAS
// ============================================================

enum Rol {
  ADMIN
  COLABORADOR
}

model Tienda {
  id        String   @id @default(cuid())
  nombre    String   @unique
  createdAt DateTime @default(now())

  usuarios       Usuario[]
  facturas       Factura[]
  notasCredito   NotaCredito[]
  guiasRemision  GuiaRemision[]
  ordenesCompra  OrdenCompra[]
}

model Usuario {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  nombre       String
  rol          Rol      @default(COLABORADOR)
  activo       Boolean  @default(true)
  tiendaId     String?
  tienda       Tienda?  @relation(fields: [tiendaId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  facturas      Factura[]
  notasCredito  NotaCredito[]
  guiasRemision GuiaRemision[]
  ordenesCompra OrdenCompra[]
}

// ============================================================
// PROVEEDORES (referencia liviana, se completa al vuelo desde
// los documentos extraídos)
// ============================================================

model Proveedor {
  ruc          String   @id
  razonSocial  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  aliasProducto ProductoAlias[]
}

// ============================================================
// MAESTRO DE PRODUCTOS (homologación)
// ============================================================

model Producto {
  id                   String   @id @default(cuid())
  codigoInterno        String   @unique
  nombreInterno        String
  unidadMedidaInterna  String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  alias              ProductoAlias[]
  lineasFactura      FacturaLinea[]
  lineasNotaCredito  NotaCreditoLinea[]
  lineasOrdenCompra  OrdenCompraLinea[]
}

// Descripción con la que un proveedor específico nombra un producto
// en sus facturas. Sirve para el mapeo automático la próxima vez.
model ProductoAlias {
  id            String   @id @default(cuid())
  productoId    String
  producto      Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  proveedorRuc  String
  proveedor     Proveedor @relation(fields: [proveedorRuc], references: [ruc])
  descripcion   String
  createdAt     DateTime @default(now())

  @@unique([proveedorRuc, descripcion])
  @@index([productoId])
}

// ============================================================
// ENUMS COMPARTIDOS DE PROCESAMIENTO
// ============================================================

enum EstadoProcesamiento {
  EXTRAYENDO
  LISTO
  ERROR
}

enum EstadoHomologacion {
  HOMOLOGADO
  PENDIENTE
}

// ============================================================
// FACTURAS
// ============================================================

enum SelloColor {
  AZUL
  ROJO
  SIN_SELLO
}

enum EstadoContable {
  CONFORME
  OBSERVADA
  SIN_SELLO
}

enum AccionContable {
  PAGAR_TOTAL
  SOLICITAR_NOTA_CREDITO
  PENDIENTE_REVISION
}

model Factura {
  id                    String   @id @default(cuid())
  numero                String
  fechaEmision          DateTime?
  fechaVencimiento      DateTime?

  proveedorRuc          String
  proveedorRazonSocial  String
  clienteRuc            String?
  clienteRazonSocial    String?

  valorVenta            Decimal? @db.Decimal(12, 2)
  igv                   Decimal? @db.Decimal(12, 2)
  importeTotal          Decimal? @db.Decimal(12, 2)
  formaPago             String?
  moneda                String   @default("PEN")

  selloColor            SelloColor      @default(SIN_SELLO)
  estadoContable        EstadoContable  @default(SIN_SELLO)
  accionContable        AccionContable  @default(PENDIENTE_REVISION)

  imagenUrl             String
  imagenPathname        String
  estadoProcesamiento   EstadoProcesamiento @default(EXTRAYENDO)
  errorProcesamiento    String?
  extraccionCruda       Json?

  subidoPorId           String
  subidoPor             Usuario  @relation(fields: [subidoPorId], references: [id])
  tiendaId              String?
  tienda                Tienda?  @relation(fields: [tiendaId], references: [id])

  createdAt             DateTime @default(now())
  updatedAt              DateTime @updatedAt

  lineas                FacturaLinea[]
  notasCredito           NotaCredito[]
  ordenesCompra          OrdenCompra[]

  @@unique([proveedorRuc, numero])
  @@index([estadoContable])
  @@index([fechaEmision])
}

model FacturaLinea {
  id                     String   @id @default(cuid())
  facturaId              String
  factura                Factura  @relation(fields: [facturaId], references: [id], onDelete: Cascade)

  codigoProveedor        String?
  descripcionProveedor   String
  cantidad               Decimal  @db.Decimal(12, 3)
  unidadMedida           String?
  precioUnitario         Decimal? @db.Decimal(12, 4)
  subtotal               Decimal? @db.Decimal(12, 2)

  productoId             String?
  producto               Producto? @relation(fields: [productoId], references: [id])
  estadoHomologacion     EstadoHomologacion @default(PENDIENTE)

  createdAt              DateTime @default(now())

  @@index([estadoHomologacion])
  @@index([productoId])
}

// ============================================================
// NOTAS DE CRÉDITO (mandan sobre la factura que rectifican)
// ============================================================

model NotaCredito {
  id                    String   @id @default(cuid())
  numero                String
  fechaEmision          DateTime?

  proveedorRuc          String
  proveedorRazonSocial  String

  facturaNumero         String
  facturaId             String?
  factura               Factura? @relation(fields: [facturaId], references: [id])

  motivo                String?
  montoTotal            Decimal? @db.Decimal(12, 2)

  imagenUrl             String
  imagenPathname        String
  estadoProcesamiento   EstadoProcesamiento @default(EXTRAYENDO)
  errorProcesamiento    String?
  extraccionCruda       Json?

  subidoPorId           String
  subidoPor             Usuario  @relation(fields: [subidoPorId], references: [id])
  tiendaId              String?
  tienda                Tienda?  @relation(fields: [tiendaId], references: [id])

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  lineas                NotaCreditoLinea[]

  @@unique([proveedorRuc, numero])
  @@index([facturaId])
}

model NotaCreditoLinea {
  id              String   @id @default(cuid())
  notaCreditoId   String
  notaCredito     NotaCredito @relation(fields: [notaCreditoId], references: [id], onDelete: Cascade)

  codigo          String?
  nombre          String
  cantidad        Decimal? @db.Decimal(12, 3)
  precioUnitario  Decimal? @db.Decimal(12, 4)
  subtotal        Decimal? @db.Decimal(12, 2)

  productoId      String?
  producto        Producto? @relation(fields: [productoId], references: [id])

  createdAt       DateTime @default(now())

  @@index([productoId])
}

// ============================================================
// GUÍAS DE REMISIÓN (solo respaldo fotográfico, sin extracción)
// ============================================================

model GuiaRemision {
  id                   String   @id @default(cuid())
  numeroGuia           String?
  facturaRelacionada   String?

  imagenUrl            String
  imagenPathname       String

  subidoPorId          String
  subidoPor            Usuario  @relation(fields: [subidoPorId], references: [id])
  tiendaId             String?
  tienda               Tienda?  @relation(fields: [tiendaId], references: [id])

  createdAt            DateTime @default(now())

  @@index([numeroGuia])
  @@index([facturaRelacionada])
}

// ============================================================
// ÓRDENES DE COMPRA
// ============================================================

enum EstadoRecepcion {
  RECIBIDO
  PARCIAL
  PENDIENTE
}

model OrdenCompra {
  id                    String   @id @default(cuid())
  numero                String
  fecha                 DateTime?

  proveedorRuc          String
  proveedorRazonSocial  String

  montoTotal            Decimal? @db.Decimal(12, 2)
  estadoRecepcion       EstadoRecepcion @default(PENDIENTE)

  facturaId             String?
  factura               Factura? @relation(fields: [facturaId], references: [id])

  imagenUrl             String
  imagenPathname        String
  estadoProcesamiento   EstadoProcesamiento @default(EXTRAYENDO)
  errorProcesamiento    String?
  extraccionCruda       Json?

  subidoPorId           String
  subidoPor             Usuario  @relation(fields: [subidoPorId], references: [id])
  tiendaId              String?
  tienda                Tienda?  @relation(fields: [tiendaId], references: [id])

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  lineas                OrdenCompraLinea[]

  @@unique([proveedorRuc, numero])
  @@index([facturaId])
}

model OrdenCompraLinea {
  id               String   @id @default(cuid())
  ordenCompraId    String
  ordenCompra      OrdenCompra @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)

  codigoInterno    String?
  descripcion      String
  cantidad         Decimal? @db.Decimal(12, 3)
  precioUnitario   Decimal? @db.Decimal(12, 4)
  subtotal         Decimal? @db.Decimal(12, 2)

  productoId       String?
  producto         Producto? @relation(fields: [productoId], references: [id])

  createdAt        DateTime @default(now())

  @@index([productoId])
}
