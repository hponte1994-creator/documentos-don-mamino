# Base de datos Postgres (Neon o Vercel Postgres). Debe incluir "?sslmode=require".
DATABASE_URL="postgresql://usuario:password@host/basededatos?sslmode=require"

# Clave de la API de Anthropic. NUNCA se expone al navegador, solo se usa en el servidor.
ANTHROPIC_API_KEY="sk-ant-..."

# Almacenamiento de imágenes (Vercel Blob). Se genera solo al conectar Vercel Blob en tu proyecto de Vercel.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Clave secreta para firmar las sesiones de login. Genera una propia con:
# openssl rand -base64 32   (o pide a Claude que te genere una)
AUTH_SECRET="pega-aqui-una-cadena-larga-y-aleatoria"

# Clave secreta solo para crear el primer usuario administrador una vez desplegada
# la app (ver instrucciones de despliegue). Después de usarla puedes dejarla como está.
SETUP_SECRET="pega-aqui-otra-cadena-larga-y-aleatoria"
